# ==========================================
# CloudSec-RAG Environment Configuration
# ==========================================

# Application Settings
APP_ENV=development
APP_PORT=8088
APP_HOST=127.0.0.1
LOG_LEVEL=INFO

# LLM Provider Configuration
# Options: "mock" (offline/zero-cost default), "gemini" (Google Gemini), "openai"
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Key (Required if DEFAULT_LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenAI API Key (Required if DEFAULT_LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Security & Anti-Hallucination Thresholds
MIN_GROUNDING_CONFIDENCE=0.85
STRICT_CITATION_ENFORCEMENT=true
PROMPT_INJECTION_SHIELD_ENABLED=true
PRIVACY_SCRUBBER_ENABLED=true

# Storage Settings
DATABASE_PATH=data/sessions/cloudsec_memory.db
BENCHMARK_DATA_PATH=data/benchmarks/cis_benchmarks.json
MAX_WORKING_MEMORY_TURNS=10
